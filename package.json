{
  "name": "kmp-test-runner",
  "version": "0.14.0",
  "type": "module",
  "description": "Parallel test runner for Kotlin Multiplatform and Android Gradle projects with an agent-friendly single-line JSON envelope. CLI + Gradle plugin.",
  "homepage": "https://github.com/oscardlfr/kmp-test-runner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oscardlfr/kmp-test-runner.git"
  },
  "bugs": {
    "url": "https://github.com/oscardlfr/kmp-test-runner/issues"
  },
  "keywords": [
    "kotlin",
    "kotlin-multiplatform",
    "kmp",
    "android",
    "gradle",
    "test-runner",
    "parallel-tests",
    "coverage"
  ],
  "author": "oscardlfr",
  "bin": {
    "kmp-test": "bin/kmp-test.js"
  },
  "files": [
    "bin/",
    "lib/",
    "scripts/",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "shellcheck": "shellcheck scripts/sh/*.sh scripts/sh/lib/*.sh",
    "check-line-endings": "node tools/check-line-endings.mjs",
    "check-executable-fixtures": "node tools/check-executable-fixtures.mjs",
    "size-check": "node tools/check-bundle-size.mjs",
    "sync-versions": "node tools/sync-versions.js",
    "version": "node tools/sync-versions.js && git add gradle-plugin/build.gradle.kts README.md CLAUDE.md .claude-plugin/plugin.json"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@vitest/coverage-v8": "^3.2.6",
    "js-tiktoken": "^1.0.21",
    "vitest": "^3.2.6"
  }
}
