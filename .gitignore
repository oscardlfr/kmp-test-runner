.env
*.env.local
node_modules/
dist/

# Local Claude Code settings (contain machine-specific permission allowlists
# that may include absolute paths and private project references — not
# portable, never commit).
.claude/
# Root-level only — npm/c8 test-coverage output. The measurement captures live
# under tools/runs/coverage/ and must NOT be ignored.
/coverage/

# v0.9 step 8: per-feature run captures (Approach A raw gradle stdout, B
# markdown, C JSON) are forensic outputs locally regenerable by re-running
# `node tools/measure-token-cost.js`. They're not tracked because the captures
# inevitably contain absolute paths + module names from whichever project the
# measurement ran against. The aggregate `cross-model-results-*.txt` files
# (small, anonymized) remain tracked as the canonical published evidence.
tools/runs/*/A-run*.txt
tools/runs/*/B-run*.txt
tools/runs/*/C-run*.txt
.gradle/
build/
.idea/
# Build cache artefacts produced when fixtures are exercised by tests
**/.kmp-test-runner-cache/
# v0.8.0 (PR6): unified runner artefacts subdir (cache/ reports/ logs/)
**/.kmp-test-runner/
**/gradle.properties
# Source-of-truth fixture properties — NOT a build artefact; tracked in git.
!tests/fixtures/kmp-cross-platform-e2e/gradle.properties
*.log
.DS_Store
Thumbs.db
# Pester -CI emits this NUnit XML at repo root
testResults.xml

# Local diagnostic / smoke captures (not for commit)
.smoke/

# Wide-smoke + wet-audit evidence files (per-pass markdown reports — local
# artefacts only, never commit; the matching tools live under tools/*.mjs).
# Evidence files reference the host's filesystem layout, project names, and
# device serials — keep them out of public commits.
WIDE-SMOKE-PASS-*.md
WET-AUDIT-*.md
MACOS-GATE-*.md
MEASUREMENT-*.md
BUGS-*.md
AUDIT-CLI-*.md
# Pre-v0.10 investigation outputs (read-only analyses produced before
# committing to an extraction strategy; cross-link a memory file with the
# distilled recommendation instead).
INVESTIGATE-*.md