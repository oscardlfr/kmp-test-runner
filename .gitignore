.env
*.env.local
node_modules/
dist/
# Root-level only — npm/c8 test-coverage output. The measurement captures live
# under tools/runs/coverage/ and must NOT be ignored.
/coverage/

# v0.9 step 8: Approach A captures are raw gradle stdout + slurped HTML/XML
# reports — on a real KMP project (e.g. shared-kmp-libs) the coverage A capture
# is ~74 MB. They're locally regenerable by re-running `node tools/measure-token-cost.js`.
# B (markdown) + C (JSON) captures and cross-model-results-*.txt remain tracked
# (small + load-bearing for evidence files like MEASUREMENT-V0.9-NOTES.md).
tools/runs/*/A-run*.txt
.gradle/
build/
.idea/
# Build cache artefacts produced when fixtures are exercised by tests
**/.kmp-test-runner-cache/
# v0.8.0 (PR6): unified runner artefacts subdir (cache/ reports/ logs/)
**/.kmp-test-runner/
**/gradle.properties
# Source-of-truth fixture properties — NOT a build artefact; tracked in git.
!tests/fixtures/kmp-cross-platform-e2e/gradle.properties
*.log
.DS_Store
Thumbs.db
# Pester -CI emits this NUnit XML at repo root
testResults.xml

# Local diagnostic / smoke captures (not for commit)
.smoke/

# Wide-smoke evidence files (per-pass markdown reports — local artefacts only,
# never commit; the wide-smoke tools live under tools/wide-smoke-pass-*.mjs).
WIDE-SMOKE-PASS-*.md