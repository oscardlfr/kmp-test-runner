# Force LF on the cross-model token-cost surface — vitest 2.1.x's
# transformer chokes on CRLF + non-ASCII chars together when importing the
# script, throwing a misleading "SyntaxError: Invalid or unexpected token"
# at the import position. CRLF alone or non-ASCII alone is fine; only the
# combination breaks. cli.test.js + lib/cli.js carry both and parse fine,
# so the trigger appears to be position- or buffer-alignment-specific
# inside vitest, not just the byte combination. Forcing LF is the cheapest
# stable workaround.
tools/measure-token-cost.js text eol=lf
tests/vitest/measure-token-cost.test.js text eol=lf
# Same vitest 2.1.x CRLF + non-ASCII trigger applies — these files contain
# em-dashes in headers / prose that break Windows vitest without LF.
tools/sync-versions.js text eol=lf
tests/vitest/sync-versions.test.js text eol=lf
# v0.9 step 7 macOS validation gate driver — same em-dash trigger.
tools/macos-validation-gate.mjs text eol=lf
tests/vitest/macos-validation-gate.test.js text eol=lf

# v0.10 #4 PR 5 Claude Code plugin packaging — vitest 2.1.x parser is
# also sensitive to CRLF on multi-line `import { ... } from "...mjs"`
# blocks even WITHOUT non-ASCII (no em-dashes in these files). Windows
# CI surfaced this in PR #245 build (windows-latest) as
# "SyntaxError: Invalid or unexpected token" at the import position.
# Pinning LF on the test + validator stops the bug from recurring after
# a fresh Windows clone with core.autocrlf=true.
tools/validate-plugin.mjs text eol=lf
tests/vitest/validate-plugin.test.js text eol=lf
tests/vitest/plugin-manifest.test.js text eol=lf
.claude-plugin/plugin.json text eol=lf

# Fixture wrapper scripts: gradlew (POSIX) needs LF; gradlew.bat needs CRLF
# so cmd.exe parses it correctly across hosts.
tests/fixtures/fake-gradlew/gradlew text eol=lf
tests/fixtures/fake-gradlew/gradlew.bat text eol=crlf

# v0.9 step 6 cross-platform E2E fixture — wrapper line endings + binary jar.
tests/fixtures/kmp-cross-platform-e2e/gradlew text eol=lf
tests/fixtures/kmp-cross-platform-e2e/gradlew.bat text eol=crlf
tests/fixtures/kmp-cross-platform-e2e/gradle/wrapper/gradle-wrapper.jar binary

# convention-flavors fixture — fake wrapper scripts need the same LF/CRLF split:
# gradlew (POSIX) LF, gradlew.bat (cmd.exe) CRLF.
tests/fixtures/convention-flavors/gradlew text eol=lf
tests/fixtures/convention-flavors/gradlew.bat text eol=crlf

# flavored-unit-only fixture — same LF/CRLF wrapper split.
tests/fixtures/flavored-unit-only/gradlew text eol=lf
tests/fixtures/flavored-unit-only/gradlew.bat text eol=crlf

# Skill convenience scripts (.skills/**/*.sh) MUST be LF — on Windows
# git-bash, CRLF corrupts `set -euo pipefail` (the trailing \r is parsed
# as part of the option name, producing `set: pipefail : invalid option
# name` at exit 2). POSIX bash on Linux/macOS works either way, so the
# bug only fires for Windows local dev. Surfaced 2026-05-17 during the
# post-PR-242/243 wet validation.
.skills/**/*.sh text eol=lf
tests/skill-scripts/*.bats text eol=lf
