#!/usr/bin/env bash
# Auth-status short-circuit -- ALWAYS the first check in this file, before any PROBE_LOG/
# invocation-counter logic below: this call must never consume an invocation-counter slot the
# rest of this fixture's own branching depends on.
if [ "$1" = "auth" ] && [ "$2" = "status" ] && [ "$3" = "--json" ]; then
  echo '{"loggedIn":true,"authMethod":"claude.ai","apiProvider":null,"subscriptionType":null}'
  exit 0
fi
# tests/fixtures/fake-claude-run-tests-executed-two-gradle/claude -- deterministic stand-in for the
# real `claude` CLI, proving the FULL per-attempt JUnit-evidence-attribution pipeline end to end:
# matrix-runner.mjs's env threading (KMP_EVAL_JUNIT_EVIDENCE_DIR/TASK/ALLOWED_INVOCATIONS), the
# per-condition scratch-directory lifecycle, junit-evidence.mjs's attributeCondition reading real
# sidecar files, and graders.mjs consuming the result -- all through one real `cli.mjs run`
# subprocess. Never invoked outside tests/vitest/agentic-eval-run-command.test.js; production runs
# always use the real, authenticated `claude` CLI.
#
# This script stands in for Claude Code itself, so it cannot spawn the REAL PostToolUse/
# PostToolUseFailure hook subprocess (Claude Code's own tool-dispatch loop is what does that) --
# mirroring this fixture family's existing convention of fabricating hook_started/hook_response
# transcript lines directly rather than spawning a real hook (see fake-claude-run-scenario-success/
# claude's own header comment). Here that convention extends one step further: this script ALSO
# writes the exact sidecar decision/evidence JSON files the real hooks would have produced --
# reimplemented inline with plain Node built-ins (crypto/fs, no production-module import) rather
# than importing junit-evidence-io.mjs directly, since matrix-runner.mjs's buildSharedEnv()
# deliberately builds a NARROW, allowlisted env for this subprocess (the same reason HOME/
# USERPROFILE are excluded) -- an arbitrary test-only env var naming a module path cannot reach
# this process. junit-evidence-io.mjs's own atomic-write/collision-handling behavior is separately
# and directly proven (real, unmocked collisions) by agentic-eval-junit-evidence-io.test.js; this
# fixture only needs a plain, correctly-shaped write for attributeCondition's READ side to consume.
#
# Both conditions run the SAME two SEQUENTIAL Gradle attempts against the SAME evidence task: the
# FIRST attempt fails (a real testcase failure), the SECOND (a --rerun-tasks retry) passes cleanly
# -- proving decision 5's "last-relevant-attempt wins" rule end to end, with each attempt's own
# JUnit evidence correctly and independently attributed (never conflated into a false ambiguity,
# the exact bug this whole fix closes).
write_sidecar() {
  local kind="$1" toolUseId="$2" recordJson="$3"
  node -e '
const fs = require("fs");
const path = require("path");
const crypto = require("crypto");
const [kind, toolUseId, recordJson] = process.argv.slice(1);
const idHash = crypto.createHash("sha256").update(toolUseId).digest("hex");
const dir = path.join(process.env.KMP_EVAL_JUNIT_EVIDENCE_DIR, kind);
fs.mkdirSync(dir, { recursive: true });
fs.writeFileSync(path.join(dir, idHash + ".json"), recordJson);
' -- "$kind" "$toolUseId" "$recordJson"
}

HAS_PLUGIN_DIR=0
PLUGIN_DIR_VALUE=""
PREV_ARG=""
for arg in "$@"; do
  if [ "$PREV_ARG" = "--plugin-dir" ]; then HAS_PLUGIN_DIR=1; PLUGIN_DIR_VALUE="$arg"; fi
  PREV_ARG="$arg"
done

if [ "$HAS_PLUGIN_DIR" = "1" ]; then
  PLUGIN_DIR_JSON=$(printf '%s' "$PLUGIN_DIR_VALUE" | sed 's/\\/\\\\/g')
  PLUGINS="[{\"name\":\"kmp-test-runner\",\"path\":\"$PLUGIN_DIR_JSON\",\"source\":\"fake\"}]"
  # Round-3 audit finding (P1): a current-skill condition's skills[] must genuinely carry the
  # target's own identity -- see fake-claude-run-scenario-success/claude's identical comment for
  # the full rationale.
  SKILLS='["kmp-test-runner"]'
else
  PLUGINS='[]'
  SKILLS='[]'
fi

echo "{\"type\":\"system\",\"subtype\":\"init\",\"cwd\":\"/fake\",\"session_id\":\"fake-sess-0001\",\"tools\":[\"Bash\",\"Skill\"],\"mcp_servers\":[],\"model\":\"claude-sonnet-5-fake-resolved\",\"permissionMode\":\"dontAsk\",\"plugins\":$PLUGINS,\"skills\":$SKILLS,\"apiKeySource\":\"none\",\"claude_code_version\":\"fake\"}"

# Bash call #1: the first Gradle attempt fails.
echo '{"type":"assistant","message":{"model":"claude-sonnet-5","content":[{"type":"tool_use","id":"toolu_fakegradle1","name":"Bash","input":{"command":"./gradlew.bat :fakemod:test --console=plain","description":"fake"}}],"usage":{"input_tokens":1,"output_tokens":1,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}'
echo '{"type":"system","subtype":"hook_started","hook_id":"fake-hook-1","hook_name":"PreToolUse:Bash","hook_event":"PreToolUse"}'
echo '{"type":"system","subtype":"hook_response","hook_id":"fake-hook-1","hook_name":"PreToolUse:Bash","hook_event":"PreToolUse","output":"{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\",\"permissionDecisionReason\":\"fake\"}}","exit_code":0,"outcome":"success"}'
write_sidecar decisions toolu_fakegradle1 '{"decision":"allow","command":"./gradlew.bat :fakemod:test --console=plain"}'
write_sidecar evidence toolu_fakegradle1 '{"command":"./gradlew.bat :fakemod:test --console=plain","status":"ok","junit":{"total":2,"passed":1,"failed":1}}'
GRADLE_FAIL_STDOUT='> Task :fakemod:test FAILED

BUILD FAILED in 2s
2 actionable tasks: 2 executed
'
node -e "console.log(JSON.stringify({type:'user',message:{role:'user',content:[{type:'tool_result',content:process.argv[1],is_error:true,tool_use_id:'toolu_fakegradle1'}]}}))" "$GRADLE_FAIL_STDOUT"

# Bash call #2: a corrected retry (--rerun-tasks), a DIFFERENT transcript index/tool_use_id --
# passes cleanly. Sequential, never same-turn, so this must NOT be flagged ambiguous.
echo '{"type":"assistant","message":{"model":"claude-sonnet-5","content":[{"type":"tool_use","id":"toolu_fakegradle2","name":"Bash","input":{"command":"./gradlew.bat :fakemod:test --console=plain --rerun-tasks","description":"fake"}}],"usage":{"input_tokens":1,"output_tokens":1,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}'
echo '{"type":"system","subtype":"hook_started","hook_id":"fake-hook-2","hook_name":"PreToolUse:Bash","hook_event":"PreToolUse"}'
echo '{"type":"system","subtype":"hook_response","hook_id":"fake-hook-2","hook_name":"PreToolUse:Bash","hook_event":"PreToolUse","output":"{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\",\"permissionDecisionReason\":\"fake\"}}","exit_code":0,"outcome":"success"}'
write_sidecar decisions toolu_fakegradle2 '{"decision":"allow","command":"./gradlew.bat :fakemod:test --console=plain --rerun-tasks"}'
write_sidecar evidence toolu_fakegradle2 '{"command":"./gradlew.bat :fakemod:test --console=plain --rerun-tasks","status":"ok","junit":{"total":2,"passed":2,"failed":0}}'
GRADLE_PASS_STDOUT='> Task :fakemod:test

BUILD SUCCESSFUL in 1s
2 actionable tasks: 2 executed
'
node -e "console.log(JSON.stringify({type:'user',message:{role:'user',content:[{type:'tool_result',content:process.argv[1],tool_use_id:'toolu_fakegradle2'}]}}))" "$GRADLE_PASS_STDOUT"

FINAL_ANSWER='The first attempt failed with 1 failure; retried with --rerun-tasks and it passed cleanly: 2/2 tests passed in the :fakemod module.

KMP_EVAL_RESULT
{"module": ":fakemod", "outcome_kind": "tests_executed", "total": 2, "passed": 2, "failed": 0}
KMP_EVAL_RESULT_END'
node -e "console.log(JSON.stringify({type:'result',subtype:'success',is_error:false,duration_ms:10,num_turns:1,result:process.argv[1],permission_denials:[],usage:{input_tokens:2,output_tokens:2,cache_read_input_tokens:0,cache_creation_input_tokens:0}}))" "$FINAL_ANSWER"
exit 0
