#!/usr/bin/env bash
# tests/fixtures/fake-claude-no-tool-use/claude -- see fake-claude-success/claude for the
# shared rationale. "no-tool-use" scenario: the no-skill arm (A, no --plugin-dir) genuinely
# attempts nothing at all; the current-skill arm (B, --plugin-dir present) genuinely attempts
# AND succeeds, mirroring fake-claude-success's verified Skill-invocation shape exactly.
#
# A live run (2026-07-19 agentic-eval revalidation) hit exactly this shape for real, and an
# earlier version of calibrationHardGate rejected it: it required the no-skill arm to ATTEMPT
# the call before trusting it, on the theory that "nothing was even tried" doesn't prove the
# calibration setup is testing what it claims to. That requirement was itself wrong -- a model
# correctly recognizing the skill isn't in its available tool list and not trying it at all is
# just as legitimate no-skill isolation proof as trying it and getting `Unknown skill` back
# (both real, observed shapes -- see the agentic-eval README's "Attempted vs. confirmed
# invocation"). calibrationHardGate's actual safety property is narrower: the no-skill arm must
# never show a CONFIRMED invocation (`skill_invoked:false`, always), and its
# `skill_invocation_attempted` must be a genuine observation (true or false, not null/unknown) --
# whether an attempt happened at all is not required either way. This fixture now exercises the
# "never attempted" half of that contract and is a PASS scenario, not a failure one; see
# tests/vitest/agentic-eval-cli-integration.test.js's own comment on the test that consumes it.
HAS_PLUGIN_DIR=0
PLUGIN_DIR_VALUE=""
PREV_ARG=""
for arg in "$@"; do
  if [ "$PREV_ARG" = "--plugin-dir" ]; then HAS_PLUGIN_DIR=1; PLUGIN_DIR_VALUE="$arg"; fi
  PREV_ARG="$arg"
done

if [ "$HAS_PLUGIN_DIR" = "1" ]; then
  # See fake-claude-success/claude for the shared rationale on reporting the REAL --plugin-dir
  # value instead of a hardcoded placeholder.
  PLUGIN_DIR_JSON=$(printf '%s' "$PLUGIN_DIR_VALUE" | sed 's/\\/\\\\/g')
  PLUGINS="[{\"name\":\"kmp-test-runner\",\"path\":\"$PLUGIN_DIR_JSON\",\"source\":\"fake\"}]"
else
  PLUGINS='[]'
fi

echo "{\"type\":\"system\",\"subtype\":\"init\",\"cwd\":\"/fake\",\"session_id\":\"fake-sess-0001\",\"tools\":[\"Bash\",\"Skill\"],\"mcp_servers\":[],\"model\":\"claude-sonnet-5-fake-resolved\",\"permissionMode\":\"dontAsk\",\"plugins\":$PLUGINS,\"skills\":[],\"apiKeySource\":\"none\",\"claude_code_version\":\"fake\"}"

if [ "$HAS_PLUGIN_DIR" = "1" ]; then
  echo '{"type":"assistant","message":{"model":"claude-sonnet-5","content":[{"type":"tool_use","id":"toolu_fakeskill1","name":"Skill","input":{"skill":"kmp-test-runner"}}],"usage":{"input_tokens":1,"output_tokens":1,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}'
  echo '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","content":"[fake skill body]","tool_use_id":"toolu_fakeskill1"}]}}'
else
  echo '{"type":"assistant","message":{"model":"claude-sonnet-5","content":[{"type":"text","text":"no tools needed"}],"usage":{"input_tokens":1,"output_tokens":1,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}'
fi
echo '{"type":"result","subtype":"success","is_error":false,"duration_ms":10,"num_turns":1,"result":"fake result text","permission_denials":[],"usage":{"input_tokens":2,"output_tokens":2,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}'
exit 0
