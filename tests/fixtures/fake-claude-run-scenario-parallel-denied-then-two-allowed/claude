#!/usr/bin/env bash
# tests/fixtures/fake-claude-run-scenario-parallel-denied-then-two-allowed/claude -- round-7
# regression: reproduces the real 2026-07-23 canary-evidence finding directly. Both conditions run
# THREE non-dry-run `kmp-test parallel` attempts against the SAME evidence_task/module: a
# wildcard-filtered attempt DENIED by the (fake) policy hook, followed by two ALLOWED attempts (a
# whole-project run, then the correctly module-filtered one). Before the fix, the denied attempt's
# decision resolved to bare `undefined` for a no_applicable_tests condition (decisionByAttempt was
# never populated at all for that outcome_kind), so graders.mjs's own deny/null exclusion gate
# never excluded it -- test_invocations_total read 3 and retries read 2 instead of the correct 2/1.
# See fake-claude-run-scenario-success/claude for the shared write_sidecar convention this reuses.
write_sidecar() {
  local kind="$1" toolUseId="$2" recordJson="$3"
  node -e '
const fs = require("fs");
const path = require("path");
const crypto = require("crypto");
const [kind, toolUseId, recordJson] = process.argv.slice(1);
const idHash = crypto.createHash("sha256").update(toolUseId).digest("hex");
const dir = path.join(process.env.KMP_EVAL_JUNIT_EVIDENCE_DIR, kind);
fs.mkdirSync(dir, { recursive: true });
fs.writeFileSync(path.join(dir, idHash + ".json"), recordJson);
' -- "$kind" "$toolUseId" "$recordJson"
}

HAS_PLUGIN_DIR=0
PLUGIN_DIR_VALUE=""
PREV_ARG=""
for arg in "$@"; do
  if [ "$PREV_ARG" = "--plugin-dir" ]; then HAS_PLUGIN_DIR=1; PLUGIN_DIR_VALUE="$arg"; fi
  PREV_ARG="$arg"
done

if [ "$HAS_PLUGIN_DIR" = "1" ]; then
  PLUGIN_DIR_JSON=$(printf '%s' "$PLUGIN_DIR_VALUE" | sed 's/\\/\\\\/g')
  PLUGINS="[{\"name\":\"kmp-test-runner\",\"path\":\"$PLUGIN_DIR_JSON\",\"source\":\"fake\"}]"
  # Round-3 audit finding (P1): a current-skill condition's skills[] must genuinely carry the
  # target's own identity -- see fake-claude-run-scenario-success/claude's identical comment for
  # the full rationale.
  SKILLS='["kmp-test-runner"]'
else
  PLUGINS='[]'
  SKILLS='[]'
fi

echo "{\"type\":\"system\",\"subtype\":\"init\",\"cwd\":\"/fake\",\"session_id\":\"fake-sess-0001\",\"tools\":[\"Bash\",\"Skill\"],\"mcp_servers\":[],\"model\":\"claude-sonnet-5-fake-resolved\",\"permissionMode\":\"dontAsk\",\"plugins\":$PLUGINS,\"skills\":$SKILLS,\"apiKeySource\":\"none\",\"claude_code_version\":\"fake\"}"

if [ "$HAS_PLUGIN_DIR" = "1" ]; then
  echo '{"type":"assistant","message":{"model":"claude-sonnet-5","content":[{"type":"tool_use","id":"toolu_fakeskill1","name":"Skill","input":{"skill":"kmp-test-runner"}}],"usage":{"input_tokens":1,"output_tokens":1,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}'
  echo '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","content":"[fake skill body]","tool_use_id":"toolu_fakeskill1"}]}}'
else
  echo '{"type":"assistant","message":{"model":"claude-sonnet-5","content":[{"type":"tool_use","id":"toolu_fakeskill1","name":"Skill","input":{"skill":"kmp-test-runner"}}],"usage":{"input_tokens":1,"output_tokens":1,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}'
  echo '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","content":"<tool_use_error>Unknown skill: kmp-test-runner</tool_use_error>","is_error":true,"tool_use_id":"toolu_fakeskill1"}]}}'
fi

# Attempt #1: wildcard filter, DENIED.
echo '{"type":"assistant","message":{"model":"claude-sonnet-5","content":[{"type":"tool_use","id":"toolu_fakebash1","name":"Bash","input":{"command":"kmp-test parallel --module-filter \"*\" --json","description":"fake"}}],"usage":{"input_tokens":1,"output_tokens":1,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}'
echo '{"type":"system","subtype":"hook_started","hook_id":"fake-hook-1","hook_name":"PreToolUse:Bash","hook_event":"PreToolUse"}'
echo '{"type":"system","subtype":"hook_response","hook_id":"fake-hook-1","hook_name":"PreToolUse:Bash","hook_event":"PreToolUse","output":"{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"fake\"}}","exit_code":0,"outcome":"success"}'
write_sidecar decisions toolu_fakebash1 '{"decision":"deny","command":"kmp-test parallel --module-filter \"*\" --json"}'
echo '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","content":"denied","tool_use_id":"toolu_fakebash1"}]}}'

# Attempt #2: whole-project run (no filter), ALLOWED -- not target-matching (no module info), but
# still a genuine EXECUTED attempt that must count toward test_invocations_total.
echo '{"type":"assistant","message":{"model":"claude-sonnet-5","content":[{"type":"tool_use","id":"toolu_fakebash2","name":"Bash","input":{"command":"kmp-test parallel --json","description":"fake"}}],"usage":{"input_tokens":1,"output_tokens":1,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}'
echo '{"type":"system","subtype":"hook_started","hook_id":"fake-hook-2","hook_name":"PreToolUse:Bash","hook_event":"PreToolUse"}'
echo '{"type":"system","subtype":"hook_response","hook_id":"fake-hook-2","hook_name":"PreToolUse:Bash","hook_event":"PreToolUse","output":"{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\",\"permissionDecisionReason\":\"fake\"}}","exit_code":0,"outcome":"success"}'
write_sidecar decisions toolu_fakebash2 '{"decision":"allow","command":"kmp-test parallel --json"}'
KMP_ENVELOPE_WHOLE='{"tool":"kmp-test","schema_version":2,"subcommand":"parallel","version":"0.14.0","project_root":"/fake","exit_code":2,"duration_ms":21,"tests":{"total":0,"passed":0,"failed":0,"skipped":0,"individual_total":0},"modules":[],"skipped":[],"coverage":{"tool":"auto","missed_lines":null,"modules_with_kover_plugin":[],"modules_with_jacoco_plugin":[]},"errors":[{"code":"no_test_modules","message":"No modules found matching filter: (none)","test_type":"","caused_by_filter":false}],"warnings":[],"isolated":{"enabled":false,"cache_dir":null,"kept":false,"locked":true}}'
node -e "console.log(JSON.stringify({type:'user',message:{role:'user',content:[{type:'tool_result',content:process.argv[1],tool_use_id:'toolu_fakebash2'}]}}))" "$KMP_ENVELOPE_WHOLE"

# Attempt #3: correctly module-filtered, ALLOWED -- target-matching, becomes terminal.
echo '{"type":"assistant","message":{"model":"claude-sonnet-5","content":[{"type":"tool_use","id":"toolu_fakebash3","name":"Bash","input":{"command":"kmp-test parallel --module-filter :fakemod --json","description":"fake"}}],"usage":{"input_tokens":1,"output_tokens":1,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}'
echo '{"type":"system","subtype":"hook_started","hook_id":"fake-hook-3","hook_name":"PreToolUse:Bash","hook_event":"PreToolUse"}'
echo '{"type":"system","subtype":"hook_response","hook_id":"fake-hook-3","hook_name":"PreToolUse:Bash","hook_event":"PreToolUse","output":"{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\",\"permissionDecisionReason\":\"fake\"}}","exit_code":0,"outcome":"success"}'
write_sidecar decisions toolu_fakebash3 '{"decision":"allow","command":"kmp-test parallel --module-filter :fakemod --json"}'
KMP_ENVELOPE='{"tool":"kmp-test","schema_version":2,"subcommand":"parallel","version":"0.14.0","project_root":"/fake","exit_code":2,"duration_ms":21,"tests":{"total":0,"passed":0,"failed":0,"skipped":0,"individual_total":0},"modules":[],"skipped":[{"module":"fakemod","reason":"no test source set"}],"coverage":{"tool":"auto","missed_lines":null,"modules_with_kover_plugin":[],"modules_with_jacoco_plugin":[]},"errors":[{"code":"no_test_modules","message":"No modules found matching filter: :fakemod","test_type":"","caused_by_filter":true}],"warnings":[],"isolated":{"enabled":false,"cache_dir":null,"kept":false,"locked":true}}'
node -e "console.log(JSON.stringify({type:'user',message:{role:'user',content:[{type:'tool_result',content:process.argv[1],tool_use_id:'toolu_fakebash3'}]}}))" "$KMP_ENVELOPE"

FINAL_ANSWER='The :fakemod module has no applicable unit tests -- kmp-test reported no test modules matching that filter.

KMP_EVAL_RESULT
{"module": ":fakemod", "outcome_kind": "no_applicable_tests"}
KMP_EVAL_RESULT_END'
node -e "console.log(JSON.stringify({type:'result',subtype:'success',is_error:false,duration_ms:10,num_turns:1,result:process.argv[1],permission_denials:[],usage:{input_tokens:2,output_tokens:2,cache_read_input_tokens:0,cache_creation_input_tokens:0}}))" "$FINAL_ANSWER"
exit 0
