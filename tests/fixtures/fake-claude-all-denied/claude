#!/usr/bin/env bash
# tests/fixtures/fake-claude-all-denied/claude -- see fake-claude-success/claude for the shared
# rationale. "all-denied" scenario: one Bash call, denied by the (fake) policy hook -- smoke's
# real-work gate (hook_deny_count===0) must fail closed on this, proving false positives can't
# slip through when the agent's commands were actually all refused. --plugin-dir-driven
# skill_available matches fake-claude-success's shape (so availabilityOk genuinely passes) --
# an earlier version hardcoded plugins:[] regardless of condition, which also failed
# availabilityOk for an unrelated reason. realWorkOk and exactCommandsOk both still fail
# together here (the one denied command is unrelated to either expected command) -- that's the
# same underlying fact tripping two named checks, not an independent fixture-design gap; see
# agentic-eval-cli-integration.test.js's own comment on this test for why it isn't split
# further (would require guessing at a real denied command's own tool_result shape, which isn't
# independently verified anywhere in this harness).
HAS_PLUGIN_DIR=0
PLUGIN_DIR_VALUE=""
PREV_ARG=""
for arg in "$@"; do
  if [ "$PREV_ARG" = "--plugin-dir" ]; then HAS_PLUGIN_DIR=1; PLUGIN_DIR_VALUE="$arg"; fi
  PREV_ARG="$arg"
done

if [ "$HAS_PLUGIN_DIR" = "1" ]; then
  # See fake-claude-success/claude for the shared rationale on reporting the REAL --plugin-dir
  # value instead of a hardcoded placeholder.
  PLUGIN_DIR_JSON=$(printf '%s' "$PLUGIN_DIR_VALUE" | sed 's/\\/\\\\/g')
  PLUGINS="[{\"name\":\"kmp-test-runner\",\"path\":\"$PLUGIN_DIR_JSON\",\"source\":\"fake\"}]"
  # Round-3 audit finding (P1): a current-skill condition's skills[] must genuinely carry the
  # target's own identity -- see fake-claude-success/claude's identical comment for the full
  # rationale.
  SKILLS='["kmp-test-runner"]'
else
  PLUGINS='[]'
  SKILLS='[]'
fi

echo "{\"type\":\"system\",\"subtype\":\"init\",\"cwd\":\"/fake\",\"session_id\":\"fake-sess-0001\",\"tools\":[\"Bash\",\"Skill\"],\"mcp_servers\":[],\"model\":\"claude-sonnet-5-fake-resolved\",\"permissionMode\":\"dontAsk\",\"plugins\":$PLUGINS,\"skills\":$SKILLS,\"apiKeySource\":\"none\",\"claude_code_version\":\"fake\"}"
echo '{"type":"assistant","message":{"model":"claude-sonnet-5","content":[{"type":"tool_use","id":"toolu_fakedenied1","name":"Bash","input":{"command":"ls","description":"explore"}}],"usage":{"input_tokens":1,"output_tokens":1,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}'
echo '{"type":"system","subtype":"hook_started","hook_id":"fake-hook-1","hook_name":"PreToolUse:Bash","hook_event":"PreToolUse"}'
echo '{"type":"system","subtype":"hook_response","hook_id":"fake-hook-1","hook_name":"PreToolUse:Bash","hook_event":"PreToolUse","output":"{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"fake\"}}","exit_code":0,"outcome":"success"}'
echo '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","content":"denied","tool_use_id":"toolu_fakedenied1"}]}}'
echo '{"type":"result","subtype":"success","is_error":false,"duration_ms":10,"num_turns":1,"result":"fake result text","permission_denials":[{"tool_name":"Bash","tool_input":{"command":"ls"}}],"usage":{"input_tokens":2,"output_tokens":2,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}'
exit 0
